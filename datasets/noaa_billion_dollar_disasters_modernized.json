{
"$schema": "http://json-schema.org/draft-07/schema#",
"title": "LighthouseUnifiedHazardSchema",
"description": "Enterprise-grade federal modernization schema blueprint engineered by Skinny Corp via CODY v7.0 for high-throughput ingestion networks.",
"type": "object",

"required": [
"dataset_metadata",
"data_governance",
"security_profile",
"modernized_records"
],

"properties": {
"dataset_metadata": {
"type": "object",
"required": [
"dataset_name",
"accession_number",
"doi",
"source",
"publisher",
"support_status",
"publication_lifecycle",
"time_range",
"spatial_bounding_box"
],
"properties": {
"dataset_name": { "type": "string" },
"accession_number": { "type": "string" },
"doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$" },
"source": { "type": "string" },
"publisher": { "type": "string" },
"support_status": { "type": "string" },

"publication_lifecycle": {
"type": "object",
"required": ["created", "published", "revised", "last_modified"],
"properties": {
"created": { "type": "string", "format": "date" },
"published": { "type": "string", "format": "date" },
"revised": { "type": "string", "format": "date" },
"last_modified": { "type": "string", "format": "date-time" }
}
},

"time_range": {
"type": "object",
"required": ["start", "end"],
"properties": {
"start": { "type": "string", "format": "date" },
"end": { "type": "string", "format": "date" }
}
},

"spatial_bounding_box": {
"type": "object",
"required": ["west", "east", "south", "north"],
"properties": {
"west": { "type": "number" },
"east": { "type": "number" },
"south": { "type": "number" },
"north": { "type": "number" }
}
}
}
},

"data_governance": {
"type": "object",
"required": [
"schema_spec",
"hazard_categories",
"data_sources",
"hazard_alignment_rules",
"agency_mapping_rules"
],
"properties": {
"schema_spec": { "type": "string" },
"hazard_categories": { "type": "array", "items": { "type": "string" } },
"data_sources": { "type": "array", "items": { "type": "string" } },
"hazard_alignment_rules": { "type": "object" },
"agency_mapping_rules": { "type": "object" }
}
},

"security_profile": {
"type": "object",
"required": ["zero_trust_model", "fips_compliance"],
"properties": {
"zero_trust_model": { "type": "string" },

"fips_compliance": {
"type": "object",
"required": ["status", "hash_algorithm", "crypto_module"],
"properties": {
"status": { "type": "string" },
"hash_algorithm": { "type": "string" },
"crypto_module": { "type": "string" }
}
}
}
},

"modernized_records": {
"type": "array",
"items": {
"type": "object",
"required": [
"event_name",
"hazard_type",
"start_date",
"end_date",
"states_affected",
"loss_usd",
"loss_usd_adjusted",
"integrity_ledger",
"quarantine_telemetry",
"enterprise_metadata_extension"
],

"properties": {
"event_name": { "type": "string" },
"hazard_type": { "type": "string" },
"start_date": { "type": "string", "format": "date" },
"end_date": { "type": "string", "format": "date" },
"states_affected": { "type": "array", "items": { "type": "string" } },

"fatalities": { "type": "integer", "minimum": 0 },
"loss_usd": { "type": "number", "minimum": 0 },
"loss_usd_adjusted": { "type": "number", "minimum": 0 },

"primary_sources": { "type": "array", "items": { "type": "string" } },
"secondary_sources": { "type": "array", "items": { "type": "string" } },

"quarantine_telemetry": {
"type": "object",
"required": [
"is_quarantined",
"upstream_trigger",
"sandbox_environment",
"release_condition"
],
"properties": {
"is_quarantined": { "type": "boolean" },
"detected_drift_version": { "type": ["string", "null"] },
"ingestion_exception_msg": { "type": ["string", "null"] },
"upstream_trigger": { "type": "string" },
"sandbox_environment": { "type": "string" },
"release_condition": { "type": "string" }
}
},

"integrity_ledger": {
"type": "object",
"required": ["record_hash", "prev_record_hash", "on_validation_failure"],
"properties": {
"record_hash": {
"type": "object",
"required": ["algorithm", "fips_validated", "value"],
"properties": {
"algorithm": { "type": "string" },
"fips_validated": { "type": "boolean" },
"value": { "type": ["string", "null"] }
}
},
"prev_record_hash": {
"type": "object",
"required": ["algorithm", "fips_validated", "value"],
"properties": {
"algorithm": { "type": "string" },
"fips_validated": { "type": "boolean" },
"value": { "type": ["string", "null"] }
}
},
"on_validation_failure": { "type": "string" }
}
},

"enterprise_metadata_extension": {
"type": "object",
"required": ["guid_ledger", "regional_boundary_routing", "cryptographic_sanitization", "risk_compliance_telemetry"],
"properties": {
"guid_ledger": {
"type": "object",
"required": ["payload_uuid", "system_origin_id", "ingestion_timestamp_utc"],
"properties": {
"payload_uuid": { "type": "string", "format": "uuid" },
"system_origin_id": { "type": "string" },
"ingestion_timestamp_utc": { "type": "string", "format": "date-time" }
}
},

"regional_boundary_routing": {
"type": "object",
"required": ["primary_fema_region", "gis_validation_status", "grid_coordinate_datum"],
"properties": {
"primary_fema_region": { "type": "string" },
"gis_validation_status": { "type": "string" },
"grid_coordinate_datum": { "type": "string" }
}
},

"cryptographic_sanitization": {
"type": "object",
"required": ["pii_scrubbed", "payload_encryption", "sanitization_protocol"],
"properties": {
"pii_scrubbed": { "type": "boolean" },
"payload_encryption": { "type": "string" },
"sanitization_protocol": { "type": "string" }
}
},

"risk_compliance_telemetry": {
"type": "object",
"required": ["automated_risk_rating", "structural_density_score", "compliance_baseline_status"],
"properties": {
"automated_risk_rating": { "type": "string" },
"structural_density_score": { "type": "number" },
"compliance_baseline_status": { "type": "string" }
}
}
}
}
}
}
}
}
}

